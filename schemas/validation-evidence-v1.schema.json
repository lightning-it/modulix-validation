{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightning-it/modulix-validation/blob/develop/schemas/validation-evidence-v1.schema.json",
  "title": "ModuLix prevalidated candidate evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "mode", "release_eligible", "outcome", "candidate", "policy", "components", "validation", "results", "lifecycle", "revocation", "github_run", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "modulix-validation-evidence"},
    "mode": {"const": "executed"},
    "release_eligible": {"const": true},
    "outcome": {"const": "success"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "policy": {"$ref": "#/$defs/policy"},
    "components": {"$ref": "#/$defs/components"},
    "validation": {"$ref": "#/$defs/validation"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "revocation": {"$ref": "#/$defs/revocation"},
    "github_run": {"$ref": "#/$defs/github_run"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "reference": {"type": "string", "pattern": "^(https|artifact|github)://.+"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_sha"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "source_sha": {"$ref": "#/$defs/sha"},
        "git_tree": {"$ref": "#/$defs/sha"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      },
      "anyOf": [{"required": ["git_tree"]}, {"required": ["artifact_digest"]}]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_sha", "matrix_sha", "validation_workflow_sha"],
      "properties": {
        "policy_sha": {"$ref": "#/$defs/sha"},
        "matrix_sha": {"$ref": "#/$defs/sha"},
        "validation_workflow_sha": {"$ref": "#/$defs/sha"},
        "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 36}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "source_sha": {"$ref": "#/$defs/sha"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      },
      "anyOf": [{"required": ["source_sha"]}, {"required": ["artifact_digest"]}]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bom", "bom_digest"],
      "properties": {
        "bom": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
        "bom_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "targets", "cells"],
      "properties": {
        "profile": {"enum": ["heavy", "application_acceptance", "combined"]},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
        "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "status"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "target": {"$ref": "#/$defs/name"},
        "status": {"const": "success"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "status", "result_reference", "log_reference", "evidence_reference"],
      "properties": {
        "cell": {"$ref": "#/$defs/name"},
        "status": {"const": "success"},
        "result_reference": {"$ref": "#/$defs/reference"},
        "log_reference": {"$ref": "#/$defs/reference"},
        "evidence_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "expires_at", "cleanup"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reference"],
          "properties": {
            "status": {"const": "success"},
            "reference": {"$ref": "#/$defs/reference"}
          }
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at"],
      "properties": {
        "status": {"const": "not_revoked"},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "github_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt", "url", "workflow_sha"],
      "properties": {
        "repository": {"const": "lightning-it/modulix-validation"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "url": {"$ref": "#/$defs/reference"},
        "workflow_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_reference", "subject_digest", "source_sha"],
      "properties": {
        "attestation_reference": {"$ref": "#/$defs/reference"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "source_sha": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
